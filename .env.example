# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Or use the newer publishable key name (app accepts either):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — https://resend.com (transactional email)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Streamquest <notifications@yourdomain.com>

# Web Push — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Database (for npm run db:migrate — Supabase Dashboard → Settings → Database → URI)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev-only seed password override (default: StreamquestDev123!)
# SEED_TEST_PASSWORD=your-local-dev-password
